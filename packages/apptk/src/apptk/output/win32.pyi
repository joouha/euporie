from collections.abc import Callable
from ctypes.wintypes import HANDLE
from typing import TextIO, TypeVar

from apptk.cursor_shapes import CursorShape
from apptk.data_structures import Size
from apptk.styles import Attrs
from apptk.win32_types import (
    CONSOLE_SCREEN_BUFFER_INFO,
    COORD,
)

from .base import Output
from .color_depth import ColorDepth

_DEBUG_RENDER_OUTPUT = False
_DEBUG_RENDER_OUTPUT_FILENAME = r"prompt-toolkit-windows-output.log"
_T = TypeVar("_T")
FG_ANSI_COLORS = _create_ansi_color_dict(FOREGROUND_COLOR)
BG_ANSI_COLORS = _create_ansi_color_dict(BACKGROUND_COLOR)

__all__ = [
    "Win32Output",
]

class NoConsoleScreenBufferError(Exception):
    def __init__(self) -> None: ...

class Win32Output(Generic[_T], Output):
    use_complete_width: bool
    default_color_depth: ColorDepth | None
    _buffer: list[str]
    stdout: TextIO
    hconsole: HANDLE
    _in_alternate_screen = False
    _hidden = False
    color_lookup_table: ColorLookupTable
    default_attrs = info.wAttributes if info else 15
    LOG = open(_DEBUG_RENDER_OUTPUT_FILENAME, "ab")
    def __init__(
        self,
        stdout: TextIO,
        use_complete_width: bool = False,
        default_color_depth: ColorDepth | None = None,
    ) -> None: ...
    def fileno(self) -> int: ...
    def encoding(self) -> str: ...
    def write(self, data: str) -> None: ...
    def write_raw(self, data: str) -> None: ...
    def get_size(self) -> Size: ...
    def _winapi(self, func: Callable[..., _T], *a: object, **kw: object) -> _T: ...
    def get_win32_screen_buffer_info(self) -> CONSOLE_SCREEN_BUFFER_INFO: ...
    def set_title(self, title: str) -> None: ...
    def clear_title(self) -> None: ...
    def erase_screen(self) -> None: ...
    def erase_down(self) -> None: ...
    def erase_end_of_line(self) -> None: ...
    def _erase(self, start: COORD, length: int) -> None: ...
    def reset_attributes(self) -> None: ...
    def set_attributes(self, attrs: Attrs, color_depth: ColorDepth) -> None: ...
    def disable_autowrap(self) -> None: ...
    def enable_autowrap(self) -> None: ...
    def cursor_goto(self, row: int = 0, column: int = 0) -> None: ...
    def cursor_up(self, amount: int) -> None: ...
    def cursor_down(self, amount: int) -> None: ...
    def cursor_forward(self, amount: int) -> None: ...
    def cursor_backward(self, amount: int) -> None: ...
    def flush(self) -> None: ...
    def get_rows_below_cursor_position(self) -> int: ...
    def scroll_buffer_to_prompt(self) -> None: ...
    def enter_alternate_screen(self) -> None: ...
    def quit_alternate_screen(self) -> None: ...
    def enable_mouse_support(self) -> None: ...
    def disable_mouse_support(self) -> None: ...
    def hide_cursor(self) -> None: ...
    def show_cursor(self) -> None: ...
    def set_cursor_shape(self, cursor_shape: CursorShape) -> None: ...
    def reset_cursor_shape(self) -> None: ...
    @classmethod
    def win32_refresh_window(cls) -> None: ...
    def get_default_color_depth(self) -> ColorDepth: ...

class FOREGROUND_COLOR:
    BLACK = 0x0000
    BLUE = 0x0001
    GREEN = 0x0002
    CYAN = 0x0003
    RED = 0x0004
    MAGENTA = 0x0005
    YELLOW = 0x0006
    GRAY = 0x0007
    INTENSITY = 0x0008  # Foreground color is intensified.

class BACKGROUND_COLOR:
    BLACK = 0x0000
    BLUE = 0x0010
    GREEN = 0x0020
    CYAN = 0x0030
    RED = 0x0040
    MAGENTA = 0x0050
    YELLOW = 0x0060
    GRAY = 0x0070
    INTENSITY = 0x0080  # Background color is intensified.

class ColorLookupTable:
    _win32_colors = self._build_color_table()
    best_match: dict[str, tuple[int, int]]
    def __init__(self) -> None: ...
    @staticmethod
    def _build_color_table() -> list[tuple[int, int, int, int, int]]: ...
    def _closest_color(self, r: int, g: int, b: int) -> tuple[int, int]: ...
    def _color_indexes(self, color: str) -> tuple[int, int]: ...
    def lookup_fg_color(self, fg_color: str) -> int: ...
    def lookup_bg_color(self, bg_color: str) -> int: ...
