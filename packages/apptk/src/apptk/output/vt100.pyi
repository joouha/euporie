class _16ColorCache:
    bg: bool
    _cache: dict[Hashable, _ColorCodeAndName]
    def __init__(self, bg: bool = False) -> None: ...
    def get_code(
        self,
        value: tuple[int, int, int],
        exclude: Sequence[str] = (),
    ) -> _ColorCodeAndName: ...
    def _get(
        self,
        value: tuple[int, int, int],
        exclude: Sequence[str] = (),
    ) -> _ColorCodeAndName: ...

class _256ColorCache(dict[tuple[int, int, int], int]):
    colors = colors
    def __init__(self) -> None: ...
    def __missing__(self, value: tuple[int, int, int]) -> int: ...

class _EscapeCodeCache:
    color_depth: ColorDepth
    def __init__(self, color_depth: ColorDepth) -> None: ...
    def __missing__(self, attrs: Attrs) -> str: ...
    def _color_name_to_rgb(self, color: str) -> tuple[int, int, int]: ...
    def _colors_to_code(
        self,
        fg_color: str,
        bg_color: str,
        ul_color: str = "",
    ) -> Iterable[str]: ...

class Vt100_Output:
    _fds_not_a_terminal: set[int] = set()
    _buffer: list[str]
    stdout: TextIO
    default_color_depth: ColorDepth | None
    _get_size: Callable[[], Size]
    term: str | None
    enable_bell: bool
    enable_cpr: bool
    _escape_code_caches: dict[ColorDepth, _EscapeCodeCache]
    _cursor_shape_changed = False
    _cursor_visible: bool | None
    _pixel_size: tuple[int, int]
    enable_passthrough: FilterOrBool
    def __init__(
        self,
        stdout: TextIO,
        get_size: Callable[[], Size],
        term: str | None = None,
        default_color_depth: ColorDepth | None = None,
        enable_bell: bool = True,
        enable_cpr: bool = True,
        enable_passthrough: FilterOrBool = False,
    ) -> None: ...
    @classmethod
    def from_pty(
        cls,
        stdout: TextIO,
        term: str | None = None,
        default_color_depth: ColorDepth | None = None,
        enable_bell: bool = True,
    ) -> Vt100_Output: ...
    def get_size(self) -> Size: ...
    def fileno(self) -> int: ...
    def encoding(self) -> str: ...
    def write_raw(self, data: str) -> None: ...
    def write(self, data: str) -> None: ...
    def set_title(self, title: str) -> None: ...
    def clear_title(self) -> None: ...
    def erase_screen(self) -> None: ...
    def enter_alternate_screen(self) -> None: ...
    def quit_alternate_screen(self) -> None: ...
    def enable_mouse_support(self) -> None: ...
    def disable_mouse_support(self) -> None: ...
    def erase_end_of_line(self) -> None: ...
    def erase_down(self) -> None: ...
    def reset_attributes(self) -> None: ...
    def set_attributes(self, attrs: Attrs, color_depth: ColorDepth) -> None: ...
    def disable_autowrap(self) -> None: ...
    def enable_autowrap(self) -> None: ...
    def enable_bracketed_paste(self) -> None: ...
    def disable_bracketed_paste(self) -> None: ...
    def reset_cursor_key_mode(self) -> None: ...
    def cursor_goto(self, row: int = 0, column: int = 0) -> None: ...
    def cursor_up(self, amount: int) -> None: ...
    def cursor_down(self, amount: int) -> None: ...
    def cursor_forward(self, amount: int) -> None: ...
    def cursor_backward(self, amount: int) -> None: ...
    def hide_cursor(self) -> None: ...
    def show_cursor(self) -> None: ...
    def set_cursor_shape(self, cursor_shape: CursorShape) -> None: ...
    def reset_cursor_shape(self) -> None: ...
    def flush(self) -> None: ...
    def ask_for_cpr(self) -> None: ...
    @property
    def responds_to_cpr(self) -> bool: ...
    def bell(self) -> None: ...
    def get_default_color_depth(self) -> ColorDepth: ...
    def begin_synced_output(self) -> None: ...
    def end_synced_output(self) -> None: ...
    def mplex_passthrough(self, cmd: str) -> str: ...
    def get_pixel_size(self) -> tuple[int, int]: ...
    def set_pixel_size(self, px: int, py: int) -> None: ...
    def close_hyperlink(self) -> None: ...
    def clear_graphics_kitty(self) -> None: ...
    def enable_sgr_pixel(self) -> None: ...
    def disable_sgr_pixel(self) -> None: ...
    def enable_palette_dsr(self) -> None: ...
    def disable_palette_dsr(self) -> None: ...
    def enable_extended_keys(self) -> None: ...
    def disable_extended_keys(self) -> None: ...
    def set_clipboard(self, text: str) -> None: ...
    def ask_for_clipboard(self) -> None: ...
